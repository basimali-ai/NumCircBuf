cdef inline size_t min_sz(size_t a, size_t b) noexcept nogil:
    return a if a < b else b


cdef str _format_index(object idx):
    if isinstance(idx, slice):
        start = '' if idx.start is None else idx.start
        stop  = '' if idx.stop  is None else idx.stop
        step  = '' if idx.step  is None else f":{idx.step}"
        if step:
            return f"{start}:{stop}:{idx.step}"
        return f"{start}:{stop}"
    else:
        return str(idx)


cdef str _view_index_error_msg(object idx):
    return (
        "\nIndexing and slicing are only supported on a snapshot view.\n"
        f"Use .view()[{_format_index(idx)}]"
    )


cdef str _iter_error_msg():
    return (
        "\nIteration is only supported on a snapshot view.\n"
        "Example:\n"
        "    view = buffer.view()\n"
        "    for x in view:\n"
        "        ..."
    )


