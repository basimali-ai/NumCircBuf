cdef class _MainBufferProtocolBase:
    pass


cdef class _InternalCircView:
    def __cinit__(
        self,
        _MainBufferProtocolBase buffer_obj,
        uintptr_t buffer_ptr,
        cnp.ndarray buffer_arr,
        int c_dtype,
        object dtype,
        size_t maxlen,
        cnp.ndarray empty_result,
    ):
        self._buffer_obj = buffer_obj
        self.buffer_ptr = <void*> buffer_ptr
        self.buffer_arr = buffer_arr
        self.c_dtype = c_dtype
        self._dtype = dtype
        self._maxlen = maxlen
        self._empty_result = empty_result

    def __len__(self) -> int:
        return self._buffer_obj.size 

    def __getitem__(self, idx: int | slice) -> float | int | np.ndarray | None:
        cdef:
            Py_ssize_t start, stop, step
            Py_ssize_t n_total, n1, n2, i
            Py_ssize_t stop_val, p2_start, stop2
            Py_ssize_t maxlen = <Py_ssize_t> self._maxlen
            Py_ssize_t size = <Py_ssize_t> self._buffer_obj.size
            Py_ssize_t start_pos = <Py_ssize_t> get_start_pos(self._buffer_obj.write_head, size, maxlen)

        if isinstance(idx, slice):
            start, stop, step = idx.indices(size)

            if step > 0:
                if start >= stop: return self._empty_result
                n_total = (stop - start + step - 1) / step
            else:
                if start <= stop: return self._empty_result
                n_total = (stop - start + step + 1) / step

            i = start + start_pos
            if i >= maxlen: i -= maxlen

            if step > 0:
                stop_val = i + (n_total - 1) * step
                if stop_val < maxlen:
                    return self.buffer_arr[
                        i : i + n_total * step : step
                    ]

                n1 = (maxlen - i + step - 1) / step 
                n2 = n_total - n1
                p2_start = (i + n1 * step) - maxlen
                return np.concatenate([ 
                    self.buffer_arr[i : maxlen : step], 
                    self.buffer_arr[p2_start : p2_start + n2 * step : step] 
                ])

            else:
                stop_val = i + (n_total - 1) * step
                if stop_val >= 0:
                    if i + n_total * step < 0:
                        return self.buffer_arr[i : : step] 
                    else:
                        return self.buffer_arr[ 
                            i : i + n_total * step : step
                        ]

                n1 = (i / -step) + 1 
                n2 = n_total - n1
                p2_start = i + (n1 * step) + maxlen

                stop2 = p2_start + n2 * step
                if stop2 < 0:
                    return np.concatenate([ 
                        self.buffer_arr[i : : step], 
                        self.buffer_arr[p2_start : : step]
                    ])
                else:
                    return np.concatenate([ 
                        self.buffer_arr[i : : step], 
                        self.buffer_arr[p2_start : stop2 : step] 
                    ])

        else:
            i = idx
            if i < 0: i += size

            if not (0 <= i < size): raise exceptions.IndexOutOfBounds(self, idx)
            
            i += start_pos
            if i >= maxlen: i -= maxlen
            
            # --- Generated c_dtype dispatch ---
            {{for idx, item in enumerate(TYPE_DEFINITIONS_EXPANDED)}}
            {{py: _, c_type, npy_const, _ = item}}
            {{'if' if idx == 0 else 'elif'}} self.c_dtype == cnp.{{npy_const}}:
                return (<{{c_type}}*> self.buffer_ptr)[i]
            {{endfor}}
            # --------------------------------

    def __iter__(self) -> Iterator[Any]:
        cdef:
            size_t i, wrap_limit, end
            bint wraps
            void* p = self.buffer_ptr
            # --- Generated buf_ptr locals ---
            {{for suffix, c_type, _, _ in TYPE_DEFINITIONS_EXPANDED}}
            {{c_type}}* buf_ptr_{{suffix}} = <{{c_type}}*> p
            {{endfor}}
            # --------------------------------
            size_t maxlen = self._maxlen
            size_t current_size = self._buffer_obj.size
            size_t current_start_pos = get_start_pos(self._buffer_obj.write_head, current_size, maxlen)

        if current_size == 0: return

        i = current_start_pos
        end = current_start_pos + current_size
        
        if end > maxlen:
            wrap_limit = end - maxlen
            end = maxlen
            wraps = True
        else:
            wraps = False

        # --- Generated c_dtype dispatch ---
        {{for idx, item in enumerate(TYPE_DEFINITIONS_EXPANDED)}}
        {{py: suffix, _, npy_const, _ = item}}
        {{'if' if idx == 0 else 'elif'}} self.c_dtype == cnp.{{npy_const}}:
            while i < end:
                yield buf_ptr_{{suffix}}[i]
                i += 1
            if wraps:
                i = 0
                while i < wrap_limit:
                    yield buf_ptr_{{suffix}}[i]
                    i += 1
        {{''}}
        {{endfor}}
        # --------------------------------

    @property
    def maxlen(self) -> int:
        return self._maxlen

    @property
    def dtype(self) -> type:
        return self._dtype

    cdef cnp.ndarray to_numpy_c(self):
        cdef:
            size_t end
            size_t size = self._buffer_obj.size
            size_t maxlen = self._maxlen
            size_t start_pos = get_start_pos(self._buffer_obj.write_head, size, maxlen)

        if size == 0:
            return self._empty_result

        end = start_pos + size

        if end <= maxlen:
            return self.buffer_arr[start_pos:end].copy()
        else:
            end -= maxlen
            return np.concatenate(
                (self.buffer_arr[start_pos:], self.buffer_arr[:end])
            )

    def to_numpy(self) -> np.ndarray:
        return self.to_numpy_c()

    def __repr__(self) -> str:
        return f"<View at {hex(id(self))} for: {repr(self._buffer_obj)}>"

    def __setitem__(self, idx, value) -> None:
        raise exceptions.InvalidModification(
            self,
            f"View is read only. "
            "Use OverwriteCircBuffer.append()/extend() "
            "or BlockingCircBuffer.write()"
            )

    def __delitem__(self, idx) -> None:
        raise exceptions.InvalidModification(
            self,
            f"View is read-only. "
            "To remove all data, use OverwriteCircBuffer.clear() "
            "or read()/clear() on BlockingCircBuffer"
        )


cdef void _init_underlying_arrays(
    _MainBufferProtocolBase self, size_t maxlen, size_t elem_size, int c_dtype
) except *:
    cdef size_t cache_line = get_cache_line()
    cdef size_t offset = (cache_line * 2) / elem_size
    cdef size_t padding = offset + (cache_line / elem_size)
    cdef cnp.npy_intp shape[1]
    
    shape[0] = maxlen + padding
    self._raw = cnp.PyArray_ZEROS(1, &shape[0], c_dtype, 0)
    shape[0] = maxlen
    cdef cnp.PyArray_Descr* descr = cnp.PyArray_DESCR(self._raw)
    Py_INCREF(<PyObject*> descr)
    cdef char* _raw_ptr = <char*> cnp.PyArray_DATA(self._raw)
    cdef void* _start_ptr = _raw_ptr + (offset * elem_size)
    self.buffer = PyArray_NewFromDescr(
        &PyArray_Type,
        descr,
        1,
        &shape[0],
        <cnp.npy_intp*> cnp.PyArray_STRIDES(self._raw),
        _start_ptr,
        cnp.NPY_ARRAY_WRITEABLE,
        None
    )
    self.buffer_ptr = _start_ptr
    
    shape[0] = 0
    self._empty_result = cnp.PyArray_SimpleNew(1, &shape[0], c_dtype)


cdef void _shared_main_buffer_init(_MainBufferProtocolBase self, object maxlen) except *:
    if not isinstance(maxlen, int):
        raise exceptions.BufferCapacityTypeError(
            self.__class__,
            type(maxlen)
        )
    elif maxlen <= 0:
        raise exceptions.BufferCapacityValueError(
            False,
            self.__class__,
            maxlen
        )
    elif maxlen > PY_SSIZE_T_MAX:
        raise exceptions.BufferCapacityValueError(
            True,
            self.__class__,
            maxlen,
        )

    self._maxlen = maxlen
    self.write_head = 0
    self.size = 0

    _init_underlying_arrays(self, maxlen, self.elem_size, self.c_dtype)

    self._view = _InternalCircView(
        self,
        <uintptr_t> self.buffer_ptr,
        self.buffer,
        self.c_dtype,
        self._dtype,
        self._maxlen,
        self._empty_result,
    )


{{def coerce_to_1d_block_np}}
        # >>> coerce_to_1d_block_np >>>
        cdef cnp.ndarray block_np = cnp.PyArray_FROM_OTF(
            block, self.c_dtype, cnp.NPY_ARRAY_FORCECAST | cnp.NPY_ARRAY_C_CONTIGUOUS
        )
        if cnp.PyArray_NDIM(block_np) != 1:
            raise exceptions.NumCircBufValueError(
                class_obj=self.__class__,
                obj=self,
                message=f"\n{repr(self)}:\n{{func_name}} expects a 1-D block/array."
            )
        # <<< coerce_to_1d_block_np <<<
{{enddef}}


cdef class BlockingCircBuffer(_MainBufferProtocolBase):
    def __cinit__(self, maxlen, dtype={{SupportedDtype.F64.value}}):
        # --- Generated dtype mapping ---
        {{for idx, item in enumerate(TYPE_DEFINITIONS_EXPANDED)}}
        {{py: _, c_type, npy_const, supported_dtype = item}}
        {{'if' if idx == 0 else 'elif'}} dtype is {{supported_dtype}}:
            self.c_dtype   = cnp.{{npy_const}}
            self.elem_size = sizeof({{c_type}})
        {{''}}
        {{endfor}}
        # --------------------------------
        else:
            raise exceptions.DataTypeError(
                self.__class__,
                dtype,
                SUPPORTED_DTYPES_ALL_TUPLE
            )

        self._dtype = dtype

        _shared_main_buffer_init(self, maxlen)

        self.read_head = 0

        self.lock = threading.Lock()
        self.not_empty = threading.Condition(self.lock)
        self.not_full = threading.Condition(self.lock)

        self.read_queue.ticket_counter.store(0)
        self.read_queue.now_serving = 0

        self.write_queue.ticket_counter.store(0)
        self.write_queue.now_serving = 0

{{def append_shared_locals()}}
