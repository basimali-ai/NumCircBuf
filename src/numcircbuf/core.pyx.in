        # <<< acquire_append_turn_and_prepare_shared_context <<<
{{enddef}}

{{def append_extend_advance_ticket_notify_and_return()}}
        # >>> append_extend_advance_ticket_notify_and_return >>>
            if self.write_queue.now_serving == ticket:
                self.write_queue.now_serving += 1

                if not self.write_queue.abandoned_tickets.empty():
                    while self.write_queue.abandoned_tickets.count(self.write_queue.now_serving):
                        self.write_queue.abandoned_tickets.erase(self.write_queue.now_serving)
                        self.write_queue.now_serving += 1
                    
                self.not_full.notify_all()
                self.not_empty.notify_all()

            else:
                self.write_queue.abandoned_tickets.insert(ticket)    

        return not timed_out       
        # <<< append_extend_advance_ticket_notify_and_return <<<
{{enddef}}

