cdef void _remove_{{target}}_{{suffix}}(
    _MainBufferProtocolBase self,
    {{c_type}}* ptr,
    size_t read_pos,
) noexcept nogil:
    cdef:
        size_t write_pos
        size_t i
        size_t size = self.size
        size_t maxlen = self._maxlen 
        size_t write_head = self.write_head
        {{c_type}} val
        size_t kept_count = <size_t> 0

    write_pos = read_pos

    {{py: _func_call = 'isnan(val)' if target == ClearTargets.NANS.value else 'isinf(val)'}}
    for i in range(size):
        val = ptr[read_pos]

        if not {{_func_call}}:
            if read_pos != write_pos:
                ptr[write_pos] = val 
            
            write_pos += 1
            if write_pos >= maxlen: write_pos = 0 
            kept_count += 1

        read_pos += 1
        if read_pos >= maxlen: read_pos = 0 

    self.size = kept_count
    self.write_head = write_pos
{{''}}
{{''}}
{{endfor}}
