    cdef bint write_extend_unchecked_c(
        self, cnp.ndarray block_np, double timeout = -1, bint warn_size = True
    ) except -1:
        cdef:
            size_t n = cnp.PyArray_DIM(block_np, 0)
            size_t elem_size, maxlen, current_write_head
            char* buf_ptr
            char* src_ptr
            uint32_t ticket
            bint timed_out = False

        if n == 0: return False

        maxlen = self._maxlen
        ticket = self.write_queue.ticket_counter.fetch_add(1)

        with self.lock:
            if n >= maxlen:
                if warn_size and n > maxlen:
                    warnings.warn(exceptions.DataSizeWarning(self, n, maxlen), stacklevel=2)

                while (
                    self.write_queue.now_serving != ticket
                    or maxlen - self.size != maxlen
                ):
{{append_extend_timeout_handling()}}

                if not timed_out:
                    elem_size = self.elem_size
                    buf_ptr = <char*> self.buffer_ptr
                    src_ptr = <char*> cnp.PyArray_DATA(block_np)

                    with nogil:
                        memcpy(
                            buf_ptr,
                            src_ptr + ((n - maxlen) * elem_size),
                            maxlen * elem_size
                        )
                        self.read_head = 0
                        self.write_head = 0
                        self.size = maxlen

            else:
                while (
                    self.write_queue.now_serving != ticket
                    or maxlen - self.size < n
                ):
{{append_extend_timeout_handling()}}

                if not timed_out:
                    elem_size = self.elem_size
                    buf_ptr = <char*> self.buffer_ptr
                    src_ptr = <char*> cnp.PyArray_DATA(block_np)

                    with nogil:
                        current_write_head = self.write_head
                        write_data(
                            buf_ptr,
                            src_ptr,
                            current_write_head,
                            maxlen,
                            n,
                            elem_size
                        )
                        self.write_head = extend_advance_head(current_write_head, maxlen, n)
                        self.size += n

{{append_extend_advance_ticket_notify_and_return()}}

    def write_extend_unchecked(
            self, cnp.ndarray block_np, double timeout = -1, bint warn_size = True
        ):
